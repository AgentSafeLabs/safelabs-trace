      "env",
      "nohup",
      "time"
    ],
    "why": {
      "read": "inspect-only commands",
      "editing": "commands that edit, move, copy or re-permission files can normally be undone",
      "destructive": "commands that delete, kill, force-push or send data cannot be undone"
    }
