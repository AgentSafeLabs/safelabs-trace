{
  "rules_version": "2b",
  "precedence": [
    "1. A manual override for the tool name is used exactly (basis manual).",
    "2. Signals: name rules (strong = explicit verbs; weak = nouns and soft verbs), description rules (D-DESC-*, basis name_rule), argument rules (hard = positively classified action field, SQL keyword, HTTP method, shell command; soft = unrecognised statement or command), declared hints (raise only).",
    "3. If any hard argument signal exists, description signals and weak name signals are dropped: arguments override the description and weak name nouns. Strong name signals (explicit destructive and send verbs, change verbs) are kept: arguments never lower an explicit verb in the tool name.",
    "4. The most severe surviving signal wins (ties: argument, name, description, declared).",
    "5. No signal at all: unknown default (state_changing, basis default_unknown)."
  ],
  "severity_order": [
    "read_only",
    "state_changing",
    "irreversible"
  ],
  "name_rules": [
    {
      "id": "N-READ",
      "severity": "read_only",
      "tokens": [
        "get",
        "read",
        "list",
        "search",
        "find",
        "fetch",
        "lookup",
        "view",
        "show",
        "describe",
        "count",
        "check",
        "calculate",
        "parse",
        "query",
        "select",
        "retrieve",
        "inspect",
        "peek",
        "status"
      ],
      "strength": "weak",
      "why": "read-type verbs and nouns in a name indicate no state change"
    },
    {
      "id": "N-CHANGE",
      "severity": "state_changing",
      "strength": "strong",
      "tokens": [
        "write",
        "create",
        "update",
        "set",
        "edit",
        "add",
        "insert",
        "put",
        "patch",
        "move",
        "rename",
        "upload",
        "save",
        "append",
        "install",
        "modify"
      ],
      "why": "explicit write-type verbs change state"
    },
    {
      "id": "N-CHANGE-WEAK",
      "severity": "state_changing",
      "strength": "weak",
      "tokens": [
        "run",
        "schedule",
        "store",
        "book",
        "approve",
        "assign",
        "commit",
        "enable",
        "disable"
      ],
      "why": "verbs that may or may not change state (run, schedule, store); an argument verdict can override"
    },
    {
      "id": "N-IRREV",
      "severity": "irreversible",
      "tokens": [
        "delete",
        "remove",
        "drop",
        "truncate",
        "destroy",
        "purge",
        "wipe",
        "erase",
        "format",
        "kill",
        "terminate",
        "revoke",
        "shutdown",
        "reboot",
        "uninstall",
        "overwrite"
      ],
      "strength": "strong",
      "why": "explicit destructive verbs remove or overwrite data and are never lowered by arguments"
    },
    {
      "id": "N-SEND",
      "severity": "irreversible",
      "strength": "strong",
      "flag": "external_effect",
      "tokens": [
        "send",
        "post",
        "publish",
        "transfer",
        "pay",
        "charge",
        "refund",
        "wire",
        "deploy",
        "tweet",
        "broadcast",
        "notify"
      ],
      "why": "explicit send, publish or pay verbs act on the outside world and cannot be recalled"
    },
    {
      "id": "N-SEND-NOUN",
      "severity": "irreversible",
      "strength": "weak",
      "flag": "external_effect",
      "tokens": [
        "email",
        "sms",
        "payment",
        "payments"
      ],
      "why": "message and payment nouns only name the domain; an action argument (draft, quote) may lower"
    },
    {
      "id": "N-EXEC",
      "severity": "irreversible",
      "flag": "arbitrary_code",
      "tokens": [
        "exec",
        "shell",
        "eval",
        "bash",
        "system",
        "spawn",
        "subprocess",
        "powershell"
      ],
      "strength": "weak",
      "why": "shell and exec words suggest arbitrary code; an argument that is a classified command overrides"
    }
  ],
  "name_phrase_rules": [
    {
      "id": "N-HANDOFF",
      "severity": "state_changing",
      "strength": "strong",
      "requires_tokens": [
        "transfer"
      ],
      "requires_any": [
        "agent",
        "agents",
        "assistant",
        "handoff"
      ],
      "replaces": [
        "N-SEND"
      ],
      "why": "transferring a conversation to an agent is workflow control, not a transfer of funds"
    }
  ],
