    "editing_patterns": [
      "\\bsed\\b[^|;&]*\\s-[a-zA-Z]*i",
      "^git\\s+(add|commit|checkout|merge|rebase|stash|pull|fetch|tag|branch|push|cherry-pick|mv|restore)\\b",
      "\\bcurl\\b.*(-X|--request)\\s*=?\\s*(PUT|PATCH)\\b"
    ],
    "destructive_commands": [
      "rm",
      "rmdir",
      "unlink",
      "shred",
      "dd",
      "mkfs",
      "truncate",
      "kill",
      "killall",
      "pkill",
      "shutdown",
      "reboot",
      "halt",
      "poweroff"
    ],
    "irreversible_patterns": [
      "\\brm\\s+(-[a-zA-Z]*[rf][a-zA-Z]*|--recursive|--force)",
      "\\bdd\\s+if=",
      "\\bmkfs",
      "\\b(shutdown|reboot|halt|poweroff)\\b",
      "\\bkill\\s+-9|\\bkillall\\b|\\bpkill\\b",
      "\\|\\s*(sudo\\s+)?(ba|z|da|)sh\\b",
      "\\bgit\\s+push\\b.*(--force|\\s-f\\b)",
      "\\bgit\\s+reset\\s+--hard",
      "\\bgit\\s+clean\\b",
      "\\bshred\\b",
      "\\bfind\\b.*(-delete|-exec)",
      ">\\s*/dev/(?!null\\b)",
      "\\bcurl\\b.*(-X|--request)\\s*=?\\s*(POST|DELETE)\\b",
      "\\bcurl\\b.*\\s(-d|--data[a-z-]*|-F|--form|-T|--upload-file)\\b"
    ],
    "irreversible_pattern_notes": [
      "recursive or forced rm deletes without recovery",
      "dd from a device overwrites targets",
      "mkfs formats a device",
      "power commands stop the host",
      "forced kill ends processes without cleanup",
      "piping into a shell runs unseen code",
      "force-pushing overwrites remote history",
      "hard reset discards work",
      "git clean deletes untracked files",
      "shred destroys file contents",
      "find with delete or exec acts on every match",
      "redirect to a device node (not the null device) overwrites it",
      "curl with a POST or DELETE request sends data out",
      "curl with a data flag sends a POST"
    ],
    "ids": {
      "read_commands": "A-SHELL-READ",
      "editing_commands": "A-SHELL-EDIT",
      "irreversible_commands": "A-SHELL-IRREV",
      "other_commands": "A-SHELL-OTHER"
    },
    "wrappers": [
