    "phrase_rules": [
      {
        "id": "D-DESC-READONLY",
        "severity": "read_only",
        "pattern": "\\bread[- ]?only\\b",
        "why": "the description states the tool is read-only"
      },
      {
        "id": "D-DESC-HISTORY",
        "severity": "irreversible",
        "pattern": "\\b(overwrit\\w*|rewrit\\w*|rewrote|force[- ]?push\\w*|squash\\w*)\\b[^.;]{0,60}\\bhistory\\b|\\bhistory\\b[^.;]{0,40}\\b(overwritten|rewritten)\\b|\\bforce[- ]?push\\w*",
        "why": "rewriting or force-pushing history loses earlier state"
      },
      {
        "id": "D-DESC-INPLACE",
        "severity": "irreversible",
        "pattern": "\\b(replac\\w*|anonymi[sz]\\w*|redact\\w*|scrub\\w*|overwrit\\w*)\\b[^.;]{0,60}\\bin[- ]place\\b|\\bin[- ]place\\b[^.;]{0,60}\\b(replac\\w*|anonymi[sz]\\w*|redact\\w*|scrub\\w*|overwrit\\w*)",
        "why": "replacing data in place loses the original values"
      },
      {
        "id": "D-DESC-PERMANENT",
        "severity": "irreversible",
        "pattern": "\\bpermanently\\b|\\birreversibl\\w+|\\bcannot be undone\\b",
