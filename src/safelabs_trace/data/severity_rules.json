  "sql_rules": [
    {
      "id": "A-SQL-READ",
      "severity": "read_only",
      "keywords": [
        "select",
        "show",
        "describe",
        "explain",
        "pragma",
        "values"
      ],
      "why": "read-only statements"
    },
    {
      "id": "A-SQL-WRITE",
      "severity": "state_changing",
      "keywords": [
        "insert",
        "update",
        "merge",
        "replace",
        "create",
        "grant",
        "upsert",
        "copy",
        "set",
        "begin",
        "commit"
      ],
      "why": "data-changing statements can normally be reverted"
    },
    {
      "id": "A-SQL-DESTRUCT",
      "severity": "irreversible",
      "keywords": [
        "delete",
        "drop",
        "truncate",
        "alter",
        "revoke",
        "vacuum",
        "reindex"
      ],
      "why": "delete, drop, truncate and schema changes lose data"
    },
    {
      "id": "A-SQL-CALL",
      "severity": "irreversible",
      "flag": "arbitrary_code",
      "keywords": [
        "call",
        "exec",
        "execute"
      ],
      "why": "stored procedures run arbitrary code"
    }
  ],
  "sql_other": {
    "id": "A-SQL-OTHER",
    "severity": "state_changing",
    "why": "an unrecognised statement is assumed to change state"
  },
  "sql_cte": {
    "lead": "with",
    "write_keywords": [
      "delete",
      "update",
      "insert",
      "merge"
    ],
    "default": "select"
  },
  "http_rules": [
    {
      "id": "A-HTTP-READ",
      "severity": "read_only",
      "methods": [
        "get",
        "head",
        "options"
      ],
      "why": "safe HTTP methods"
    },
    {
      "id": "A-HTTP-WRITE",
      "severity": "state_changing",
      "methods": [
        "put",
        "patch"
      ],
      "why": "idempotent writes replace or modify a resource"
    },
    {
      "id": "A-HTTP-POST",
      "severity": "irreversible",
      "methods": [
        "post"
      ],
      "why": "POST submits data to a remote service; the effect cannot be assumed reversible"
    },
    {
      "id": "A-HTTP-DELETE",
      "severity": "irreversible",
      "methods": [
        "delete"
      ],
      "why": "DELETE removes a remote resource"
    }
  ],
